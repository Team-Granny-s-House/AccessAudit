TINYFISH_API_KEY=
WALKER_MODE=tinyfish        # tinyfish | local (local = development only)
TF_BROWSER_PROXY=default    # default | direct  (direct = {"enabled": false})
FRONTEND_URL=http://localhost:3000
DATA_DIR=./data
FORCE_BASELINE_OVERRIDE=0   # 1 = use hand-checked steps even if the Agent succeeds
CACHE_BASELINES=1           # 1 = reuse saved Agent baselines (set 0 for the live demo)
ANTHROPIC_API_KEY=          # stretch only: AI fix generator
LLM_MODEL=                  # stretch only
